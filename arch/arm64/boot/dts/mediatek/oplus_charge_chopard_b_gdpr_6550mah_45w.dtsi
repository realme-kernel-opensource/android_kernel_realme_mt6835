								 4200 25 0 0 0
								 4230 23 0 0 0
								 4230 20 0 0 0
								 4510 19 0 0 0
								 4540 16 0 0 0
								 4540 15 0 0 0
								 4550 10 1 0 0>;
				strategy_temp_normal_low =	<4200 41 0 0 0
								 4200 40 0 0 0
								 4200 35 0 0 0
								 4200 30 0 0 0
								 4200 25 0 0 0
								 4230 23 0 0 0
								 4230 20 0 0 0
								 4510 19 0 0 0
								 4540 16 0 0 0
								 4540 15 0 0 0
								 4550 10 1 0 0>;
				strategy_temp_normal_high =	<4200 41 0 0 0
								 4200 40 0 0 0
								 4200 35 0 0 0
								 4200 30 0 0 0
								 4200 25 0 0 0
								 4230 23 0 0 0
								 4230 20 0 0 0
								 4510 19 0 0 0
								 4550 16 1 0 0>;
				strategy_temp_warm = <4120 20 0 0 0
								 4120 15 0 0 0
								 4130 10 1 0 0>;
			};

			strategy_soc_50_to_75 { /* 56 ~ 75 */
				strategy_temp_little_cold =	<4150 10 0 0 0>;
				strategy_temp_cool = <4150 15 0 0 0
								 4520 10 1 0 0>;
				strategy_temp_little_cool =	<4150 20 0 0 0
								 4510 17 0 0 0
								 4510 15 0 0 0
								 4550 10 1 0 0>;
				strategy_temp_little_cool_high = <4230 20 0 0 0
								 4510 19 0 0 0
								 4540 16 0 0 0
								 4540 15 0 0 0
								 4550 10 1 0 0>;
				strategy_temp_normal_low = <4200 25 0 0 0
								 4230 23 0 0 0
								 4230 20 0 0 0
								 4510 19 0 0 0
								 4540 16 0 0 0
								 4540 15 0 0 0
								 4550 10 1 0 0>;
				strategy_temp_normal_high =	<4200 25 0 0 0
								 4230 23 0 0 0
								 4230 20 0 0 0
								 4510 19 0 0 0
								 4550 16 1 0 0>;
				strategy_temp_warm = <4130 10 1 0 0>;
			};

			strategy_soc_75_to_85 {	/*76 ~ 85*/
				strategy_temp_little_cold =	<4150 10 1 0 0>;
				strategy_temp_cool = <4520 10 1 0 0>;
				strategy_temp_little_cool =	<4510 15 0 0 0
								 4550 10 1 0 0>;
				strategy_temp_little_cool_high = <4540 15 0 0 0
								 4550 10 1 0 0>;
				strategy_temp_normal_low =	<4540 15 0 0 0
								 4550 10 1 0 0>;
